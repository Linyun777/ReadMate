# 伴读 · ReadMate · 服务端配置
#
# ============================================================================
#  这就是「换模型 / 换 Provider」的唯一入口。改完**重启服务**即生效。
# ============================================================================
#
# 用法：
#   cp .env.example .env      # Windows: copy .env.example .env
#   然后填入下面的值
#
# .env 不会被提交（见仓库根 .gitignore）。
# **API Key 只存在于这个文件里，绝不下发到浏览器端**（方案第 52 节原则三）。
#
# ---------------------------------------------------------------------------
#  只想快速跑起来？改这三行就够了
# ---------------------------------------------------------------------------
#
#   LLM_API_KEY=<你的 key>
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-flash
#
# 其余保持默认即可。


# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8000


# ===========================================================================
#  LLM Provider
# ===========================================================================
# openai_compatible : 调用任意 OpenAI 兼容接口（默认，用下面的三项配置）
# mock              : 返回确定性结果，不发起真实模型请求。
#                     本地开发与 E2E 必须使用此值。
LLM_PROVIDER=openai_compatible


# ===========================================================================
#  连接信息（仅 LLM_PROVIDER=openai_compatible 时需要）
# ===========================================================================
# 任何 OpenAI 兼容的服务都能用。填「接口地址 + 模型名」即可切换。
#
#   DeepSeek        https://api.deepseek.com/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   硅基流动         https://api.siliconflow.cn/v1
#   月之暗面         https://api.moonshot.cn/v1
#   本地 Ollama     http://127.0.0.1:11434/v1     （Key 随便填，如 ollama）
#   本地 vLLM       http://127.0.0.1:8000/v1
#
# ⚠️ 模型名与价格随时会变，**以各家官方文档为准**，这里不写死。
#
# 想确认某个名字还有效？直接问 Provider：
#   curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
# 废弃的旧名字有时还能调通（宽限期），但随时会停——以 /models 的结果为准。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash


# ---- 总结 / 学习笔记专用的模型 ----
# 留空 = 与上面的 LLM_MODEL 相同。
#
# 为什么值得单独配：这两件事比翻译更吃**理解能力**（要抓主旨、分辨主次、
# 提炼概念），而翻译只是转换。用同一个模型意味着要么翻译过剩、要么总结不足。
#
# 哪些接口用它：
#   POST /api/v1/summary   总结（右键选中 / 侧边栏）
#   POST /api/v1/note      学习笔记（阅读模式）
#
# 哪些接口用 LLM_MODEL：
#   POST /api/v1/translate 翻译
#   POST /api/v1/explain   AI 解释
LLM_SUMMARY_MODEL=


# ---- 超时（秒）----
# 长文章的总结 / 笔记可能跑得久，遇到超时先调这个
LLM_TIMEOUT=60


# ===========================================================================
#  生成参数（一般不用改）
# ===========================================================================
# 翻译是确定性任务，温度固定为 0
LLM_TEMPERATURE=0.0

# 是否请求 Provider 返回 JSON 对象（OpenAI 的 response_format）。
# 主流云端 Provider 都支持；若某个兼容接口不支持，置为 false，
# 此时仅靠 Prompt 约束输出格式。
LLM_JSON_MODE=true


# ===========================================================================
#  仅 LLM_PROVIDER=mock 时生效（本地开发与测试用，正常使用不用管）
# ===========================================================================
# ok | drop-placeholder | missing-id | duplicate-id | invalid-json
# 用于模拟各种异常返回，验证校验路径
LLM_MOCK_MODE=ok

# mock 流式输出的段间隔（毫秒）。默认 0。
# E2E 用它拉开时间窗，以便断言「完成一段就渲染一段」的中间状态。
# 代价是每次翻译都会慢这么多——只给测试用，正常运行保持 0。
LLM_MOCK_STREAM_DELAY_MS=0
