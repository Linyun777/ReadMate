{
  "name": "readmate-extension",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "伴读 · ReadMate — 浏览器扩展（WXT + TypeScript + Manifest V3）",
  "license": "MIT",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/filesystem": "^0.0.36",
    "@types/har-format": "^1.2.16",
    "@types/node": "^22.20.3",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  }
}
